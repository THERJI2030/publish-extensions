// src/pages/portal/Dashboard.js
import { MediaRecorder, DocumentUploader, TranscriptViewer } from '../components';

export default function Dashboard() {
  return (
    <div className="dashboard">
      <h1>RJI Secure Portal</h1>
      <section>
        <h2>Record Testimony</h2>
        <MediaRecorder />
      </section>
      <section>
        <h2>Upload Documents</h2>
        <DocumentUploader />
      </section>
      <section>
        <h2>Recent Transcripts</h2>
        <TranscriptViewer />
      </section>
    </div>
  );
}

